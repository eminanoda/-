rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 文字起こし用アップロードは、認証済みユーザーが自分のフォルダにのみ書ける。
    // 読み取りはクライアントには許可せず、サーバー(Admin SDK / Speech API)経由のみ。
    match /transcription-uploads/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow read: if false;
    }

    // それ以外はすべて拒否。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
